{
    "name": "ikechukwukalu/magicmake",
    "description": "A scaffolding package for an opinionated Laravel coding style.",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Ikechukwukalu\\Magicmake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ikechukwukalu\\Magicmake\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "authors": [
        {
            "name": "Ikechukwu Kalu",
            "email": "ea.ikechukwukalu@gmail.com"
        }
    ],
    "require": {
        "calebporzio/sushi": "^2.4",
        "hisorange/browser-detect": "^4.5|^5.0",
        "ikechukwukalu/clamavfileupload": "^4.0",
        "ikechukwukalu/makeservice": "^4.0",
        "ikechukwukalu/requirepin": "^3.0",
        "illuminate/console": "^12.0",
        "illuminate/support": "^12.0",
        "kreait/laravel-firebase": "^5.6|^6.0",
        "knuckleswtf/scribe": "^4.29|^5.0",
        "laravel/socialite": "^5.5",
        "laravel/ui": "^4.4",
        "laragear/two-factor": "^1.2|^2.0|^3.0",
        "php": "^8.2",
        "predis/predis": "^2.1|^3.0",
        "pusher/pusher-php-server": "^7.2",
        "sentry/sentry-laravel": "^4.1",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-permission": "^6.3",
        "stevebauman/location": "^6.6|^7.0",
        "symfony/console": "^7.2",
        "symfony/finder": "^7.2",
        "mobiledetect/mobiledetectlib": "^2.8.32|^4.8"
    },
    "require-dev": {
        "mockery/mockery": "^1.0|^2.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "php-parallel-lint/php-parallel-lint": "^1.4"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ikechukwukalu\\Magicmake\\MagicmakeServiceProvider"
            ]
        }
    }
}
